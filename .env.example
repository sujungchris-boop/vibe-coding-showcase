# api/generate.js 환경변수 템플릿
# 실제 값은 .env.local(로컬 vercel dev용) 또는 Vercel 대시보드(배포용)에 넣는다.
# 이 파일에는 절대 진짜 키를 넣지 말 것 — 커밋되는 파일임.

# 사용할 LLM 제공사: gemini(기본) | claude
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com 에서 발급)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude (LLM_PROVIDER=claude 로 바꾸면 사용. https://console.anthropic.com 에서 키 발급)
#   가성비  claude-haiku-4-5   |   품질↑  claude-sonnet-4-6
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
